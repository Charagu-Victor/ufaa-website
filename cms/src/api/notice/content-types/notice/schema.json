{
  "kind": "collectionType",
  "collectionName": "notices",
  "info": {
    "singularName": "notice",
    "pluralName": "notices",
    "displayName": "Notice"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "Public Notice",
        "Unclaimed Assets Listing",
        "Holders Notice",
        "Gazette Notice",
        "Other"
      ],
      "default": "Public Notice"
    },
    "publishedOn": {
      "type": "date",
      "required": true
    },
    "expiresOn": {
      "type": "date"
    },
    "document": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "files"
      ]
    }
  }
}
