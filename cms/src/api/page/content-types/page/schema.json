{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Page"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "parent": {
      "type": "enumeration",
      "enum": [
        "about",
        "services",
        "find-and-claim",
        "holders",
        "none"
      ],
      "default": "none"
    },
    "body": {
      "type": "richtext"
    },
    "sections": {
      "type": "component",
      "repeatable": true,
      "component": "shared.content-section"
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
